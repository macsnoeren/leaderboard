# Kopieer naar docker/.env en pas aan. Alles is optioneel.
APP_PORT=8088
# BASE_URL=http://localhost:8088

# E-mail staat standaard uit (test modus)
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Assignment System

# AI-agent (1 = aan, 0 = uit). Modellen komas-gescheiden, moeten in Ollama op de host staan.
AI_AGENT_ENABLED=1
AI_MODELS=qwen2.5:1.5b
AI_POLL_INTERVAL=30
