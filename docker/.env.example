# Kopieer naar docker/.env en pas aan. Alles is optioneel.
APP_PORT=8088
# BASE_URL=http://localhost:8088

# E-mail staat standaard uit (test modus)
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 'tls' (STARTTLS), 'ssl' of leeg (geen versleuteling); SMTP_AUTH=false logt niet in
SMTP_SECURE=tls
SMTP_AUTH=true
FROM_EMAIL=
FROM_NAME=Assignment System

# Mail testen met Mailpit (draait mee in docker compose, bekijk de mail op http://localhost:8025):
# ENABLE_EMAIL=true
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=
# SMTP_AUTH=false
# FROM_EMAIL=leaderboard@example.com

# Beheerders moeten 2FA instellen voordat ze verder kunnen
REQUIRE_2FA_ADMIN=false

# Link naar de darknet-chat onder "Tools" in de admin-zijbalk (standaard https://zebrawavesecurity.info/_dark_web_chat/); leeg = niet tonen
# DARKNET_CHAT_URL=

# AI-agent in de container 'agent' (1 = aan, 0 = uit). De agent praat met de Ollama op de host; die
# stuurt de -cloud-modellen door, maar alleen na eenmalig "ollama signin" op de host.
AI_AGENT_ENABLED=1
AI_POLL_INTERVAL=10
# OLLAMA_URL=http://localhost:11434/api/chat
# Model en denkniveau (low | medium | high; leeg = standaard) per agent. Standaard: gpt-oss:20b-cloud voor
# intentie, hulp-agent en beoordelaar, gpt-oss:120b-cloud voor validator en opdracht-assistent.
# AI_INTENT_MODEL=gpt-oss:20b-cloud
# AI_INTENT_THINK=low
# AI_HELPER_MODEL=gpt-oss:20b-cloud
# AI_HELPER_THINK=low
# Meerdere beoordelaars (komma's of spaties) = meerderheidsstem; oneens = naar de docent
# AI_ASSESSOR_MODELS=gpt-oss:20b-cloud
# AI_ASSESSOR_THINK=medium
# AI_VALIDATOR_MODEL=gpt-oss:120b-cloud
# AI_VALIDATOR_THINK=high
# AI_DESIGNER_MODEL=gpt-oss:120b-cloud
# AI_DESIGNER_THINK=high
# Alleen cloudmodellen (naam eindigt op -cloud of :cloud): er draait geen model op deze machine.
# Een lokaal model wordt geweigerd zolang AI_CLOUD_ONLY=1 (standaard).
# AI_CLOUD_ONLY=1
# AI_MAX_CHAT_TOKENS=20000
# AI_LLM_TIMEOUT=120
# Agent tegen een andere server laten draaien (leeg = de webcontainer van deze compose):
# AI_BASE_URL=https://leaderboard.example.nl/api.php
# AI_API_KEY=

# Worker (export/import, backups, rapporten). Elke nacht om WORKER_BACKUP_TIME (tijdzone TZ) een backup;
# leeg = geen automatische backups. Bewaren: laatste N automatische, handmatige en veiligheidsbackups zoveel
# dagen (0 = nooit verwijderen).
# TZ=Europe/Amsterdam
# WORKER_BACKUP_TIME=03:00
# WORKER_BACKUP_KEEP=14
# WORKER_BACKUP_MANUAL_DAYS=90
# WORKER_BACKUP_PRE_RESTORE_DAYS=30
# WORKER_BACKUP_MIN_FREE_MB=500
# Exports en rapporten zoveel dagen te downloaden; grootste archief voor import/restore (MB)
# WORKER_RESULT_TTL_DAYS=7
# WORKER_MAX_ARCHIVE_MB=500
