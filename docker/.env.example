# Kopieer naar docker/.env en pas aan. Alles is optioneel.
APP_PORT=8088
# BASE_URL=http://localhost:8088

# E-mail staat standaard uit (test modus)
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 'tls' (STARTTLS), 'ssl' of leeg (geen versleuteling); SMTP_AUTH=false logt niet in
SMTP_SECURE=tls
SMTP_AUTH=true
FROM_EMAIL=
FROM_NAME=Assignment System

# Mail testen met Mailpit (draait mee in docker compose, bekijk de mail op http://localhost:8025):
# ENABLE_EMAIL=true
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=
# SMTP_AUTH=false
# FROM_EMAIL=leaderboard@example.com

# Beheerders moeten 2FA instellen voordat ze verder kunnen
REQUIRE_2FA_ADMIN=false

# AI-agent (1 = aan, 0 = uit). Modellen komas-gescheiden, moeten in Ollama op de host staan.
AI_AGENT_ENABLED=1
AI_MODELS=qwen2.5:1.5b
AI_POLL_INTERVAL=30
