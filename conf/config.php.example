// NOTE: Please change the values and save the file as config.php

// Database configuration (zelfde pad als bin/setup.sh en de Python-scripts)
define('DB_FILE', __DIR__ . '/../database/leaderboard.db');

// Worker-service (worker-service/README.md): uploads, exports, rapporten en backups, buiten de webroot.
// Zelfde map als STORAGE_DIR in worker-service/config.py.
define('STORAGE_DIR', __DIR__ . '/../storage');
// Grootste archief voor import en restore (MB); verhoog ook upload_max_filesize en post_max_size in php.ini
define('MAX_ARCHIVE_MB', 500);
// Zoveel dagen blijven exports en rapporten te downloaden (gelijk aan RESULT_TTL_DAYS in worker-service/config.py)
define('RESULT_TTL_DAYS', 7);

// Email configuration
define('ENABLE_EMAIL', True); // Gebruik voor het testen False!
define('SMTP_HOST', 'smtp.gmail.com');
define('SMTP_PORT', 587);
define('SMTP_USER', '<your-email@gmail.com>');
define('SMTP_PASS', '<your-app-password>');
define('SMTP_SECURE', 'tls'); // 'tls' (STARTTLS), 'ssl' of '' (geen versleuteling, bijv. Mailpit)
define('SMTP_AUTH', true);    // false: niet inloggen bij de SMTP-server (bijv. Mailpit)
define('FROM_EMAIL', '<your-email@gmail.com>');
define('FROM_NAME', 'Assignment System');

// Base URL: het publieke adres van htdocs/, zonder '/' aan het eind.
// Wordt gebruikt voor de links in mails: downloads, uitnodigingen en wachtwoordherstel.
define('BASE_URL', 'https://localhost/leaderboard');

// Beheerders moeten tweestapsverificatie (2FA) instellen voordat ze verder kunnen
define('REQUIRE_2FA_ADMIN', false);

// Link naar de darknet-chat onder "Tools" in de admin-zijbalk; leeg = niet tonen (zonder deze regel geldt dezelfde URL)
define('DARKNET_CHAT_URL', 'https://zebrawavesecurity.info/_dark_web_chat/');

?>
